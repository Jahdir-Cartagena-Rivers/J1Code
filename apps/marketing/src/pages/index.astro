---
import { Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import Layout from "../layouts/Layout.astro";
import { BUILD_GUIDE_URL, GITHUB_REPOSITORY_URL, MOBILE_BUILD_GUIDE_URL, RELEASES_URL } from "../lib/site";

const features = [
  ["Your coding providers", "Use your own Codex, Claude Code, Cursor, Grok, OpenCode, and Antigravity accounts."],
  ["Shared Hive Mind", "Remember, recall, and correct information across your configured agents and projects."],
  ["Agent delegation", "Give bounded tasks to workers, follow their saved chats, and inspect their results."],
  ["Native Dot chat", "Connect your ChatGPT Dot to a native J1 conversation with separately scoped memory access."],
  ["Local and remote work", "Keep your projects on their host machine and connect through the routes you configure."],
  ["Desktop, web, and mobile", "Install a published desktop build or build the other clients from source."],
];
---

<Layout>
  <section class="j1-hero container">
    <Image src={appIcon} width={104} height={104} alt="J1 Code logo" loading="eager" />
    <p class="eyebrow">Your workspace. Your providers.</p>
    <h1>J1 Code</h1>
    <p class="intro">One workspace for coding agents, shared memory, and work across providers. Bring your own accounts and keep control of your environments.</p>
    <div class="actions">
      <a class="btn btn-primary btn-lg" href="/download">Get J1 Code</a>
      <a class="btn btn-secondary btn-lg" href={GITHUB_REPOSITORY_URL}>View the source</a>
    </div>
  </section>
  <section class="container feature-grid" aria-label="J1 Code features">
    {features.map(([title, description]) => <article><h2>{title}</h2><p>{description}</p></article>)}
  </section>
  <section class="container j1-setup">
    <h2>Plug in your own information</h2>
    <p>Start with your provider accounts and project folders. Optional cloud, relay, signing, and telemetry settings use your own configuration.</p>
    <div class="actions">
      <a href={BUILD_GUIDE_URL}>Build and setup guide</a>
      <a href={MOBILE_BUILD_GUIDE_URL}>Mobile builds</a>
      <a href={RELEASES_URL}>Release history</a>
    </div>
    <p class="attribution">J1 Code is an independently maintained derivative of <a href="https://github.com/pingdotgg/t3code">T3 Code</a>, whose MIT license is preserved. New protected J1 material has separate <a href="/terms-of-service">license terms</a>.</p>
  </section>
</Layout>

<style>
  .j1-hero { padding: 88px 0 56px; text-align: center; }
  .j1-hero img { margin: 0 auto 28px; border-radius: 22px; }
  .j1-hero h1 { font-size: clamp(48px, 9vw, 88px); letter-spacing: -0.05em; }
  .intro { max-width: 680px; margin: 24px auto; font-size: 20px; line-height: 1.6; color: var(--fg-muted); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin-top: 28px; }
  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; padding-bottom: 56px; }
  article { border: 1px solid var(--border); padding: 28px; border-radius: 16px; background: var(--bg-card); }
  article h2 { font-size: 19px; margin-bottom: 12px; }
  article p, .j1-setup p { color: var(--fg-muted); line-height: 1.7; }
  .j1-setup { max-width: 800px; text-align: center; padding: 24px 0 80px; }
  .j1-setup h2 { font-size: 30px; margin-bottom: 20px; }
  .attribution { margin-top: 36px; font-size: 14px; }
</style>
