---
import Layout from "../layouts/Layout.astro";
import { BUILD_GUIDE_URL, GITHUB_REPOSITORY_URL, MOBILE_BUILD_GUIDE_URL, RELEASES_URL } from "../lib/site";
import { J1_SOURCE_URL } from "@t3tools/shared/j1Brand";

// Hero switchboard: providers wire into the J1 hub, which fans out to clients.
const providers = [
  ["Codex", "openai_dark.svg"],
  ["Claude Code", "claude-ai-icon.svg"],
  ["Cursor", "cursor_light.svg"],
  ["Grok", "grok-dark.svg"],
  ["OpenCode", "opencode-dark.svg"],
  ["Antigravity", "antigravity.svg"],
].map(([name, logo], i) => {
  const y = 70 + i * 84;
  return { name, logo, y, path: `M196 ${y} H330 C440 ${y} 420 280 528 280` };
});
const surfaces = ["Desktop", "Web", "Mobile"].map((name, i) => {
  const y = 170 + i * 110;
  return { name, y, path: `M672 280 C780 280 760 ${y} 870 ${y} H1004` };
});

// Hive Mind honeycomb, pointy-top hexes. Labeled cells name the kinds of facts it keeps.
const hexR = 34;
const hexLabels: Record<string, string> = {
  "1,1": "preference",
  "3,0": "decision",
  "4,2": "concept",
  "2,2": "project",
  "5,1": "correction",
  "1,3": "source",
};
const hexes = Array.from({ length: 4 }, (_, row) =>
  Array.from({ length: 6 }, (_, col) => {
    const cx = 44 + col * hexR * Math.sqrt(3) + (row % 2) * ((hexR * Math.sqrt(3)) / 2);
    const cy = 42 + row * hexR * 1.5;
    const points = Array.from({ length: 6 }, (_, k) => {
      const a = (Math.PI / 180) * (60 * k - 30);
      return `${(cx + (hexR - 2) * Math.cos(a)).toFixed(1)},${(cy + (hexR - 2) * Math.sin(a)).toFixed(1)}`;
    }).join(" ");
    return { cx, cy, points, label: hexLabels[`${col},${row}`], d: (row + col) * 70 };
  }),
).flat();

const workers = [
  ["worker · codex", 20],
  ["worker · claude", 130],
  ["worker · opencode", 240],
] as const;

const routes = ["local network", "Tailscale", "J1 Connect"];

const availability = [
  ["Windows desktop", "Published installer", "published", "/download"],
  ["Linux server runtime", "Published archive", "published", "/download"],
  ["macOS desktop", "Build from source", "source", BUILD_GUIDE_URL],
  ["Web client", "Build from source", "source", BUILD_GUIDE_URL],
  ["iOS and Android", "Build with your signing", "source", MOBILE_BUILD_GUIDE_URL],
] as const;
---

<Layout>
  <section class="hero">
    <div class="container hero-copy">
      <p class="eyebrow" data-rise>Bring your own subscription · Open source</p>
      <h1 data-rise style="--d: 80ms">
        Every coding agent.<br /><span>One workspace.</span>
      </h1>
      <div class="hero-row">
        <p class="intro" data-rise style="--d: 160ms">
          J1 Code wires your own Codex, Claude Code, Cursor, Grok, OpenCode, and Antigravity
          accounts into one place, with shared memory, bounded delegation, and the environments
          you control.
        </p>
        <div class="actions" data-rise style="--d: 240ms">
          <a class="btn btn-primary btn-lg" href="/download">Get J1 Code <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <a class="btn btn-secondary btn-lg" href={GITHUB_REPOSITORY_URL}>View the source</a>
        </div>
      </div>
    </div>

    <figure class="switchboard container" data-rise style="--d: 200ms">
      <svg class="board is-live" viewBox="0 0 1200 560" role="img" aria-labelledby="board-title">
        <title id="board-title">Six provider harnesses connect into J1 Code, which serves desktop, web, and mobile clients.</title>
        <defs>
          <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
            <path d="M24 0H0V24" fill="none" stroke="rgba(243,240,230,0.05)" />
          </pattern>
        </defs>
        <rect width="1200" height="560" fill="url(#grid)" />

        {providers.map((p, i) => (
          <g class="lane" style={`--i: ${i}`}>
            <path class="trace" d={p.path} pathLength="1" />
            <path class="pulse" d={p.path} pathLength="1" />
            <rect class="node" x="140" y={p.y - 24} width="48" height="48" rx="8" />
            <image href={`/harnesses/${p.logo}`} x="152" y={p.y - 12} width="24" height="24" />
            <text class="node-label" x="124" y={p.y + 4} text-anchor="end">{p.name}</text>
            <circle class="pin" cx="196" cy={p.y} r="3" />
          </g>
        ))}

        {surfaces.map((s, i) => (
          <g class="lane lane-out" style={`--i: ${i}`}>
            <path class="trace" d={s.path} pathLength="1" />
            <path class="pulse" d={s.path} pathLength="1" />
            <circle class="pin" cx="1004" cy={s.y} r="3" />
            <rect class="node node-surface" x="1012" y={s.y - 22} width="120" height="44" rx="6" />
            <text class="surface-label" x="1072" y={s.y + 5} text-anchor="middle">{s.name}</text>
          </g>
        ))}

        <g class="hub">
          <rect class="hub-ring hub-ring-2" x="496" y="176" width="208" height="208" rx="40" />
          <rect class="hub-ring" x="514" y="194" width="172" height="172" rx="34" />
          <rect class="hub-body" x="528" y="208" width="144" height="144" rx="28" />
          <path class="hub-glyph" d="M560 248h28v42a18 18 0 0 1-36 0M610 258l18-10h6v64M614 312h32" />
          <text class="hub-label" x="600" y="410" text-anchor="middle">server · your machine</text>
        </g>
      </svg>
      <figcaption>
        <span class="eyebrow">6 providers &rarr; 1 server &rarr; 3 clients</span>
        <button type="button" class="replay" data-replay>
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.5v9l8-4.5z" fill="currentColor" /></svg>
          Send a turn
        </button>
      </figcaption>
    </figure>
  </section>

  <section class="chapter container" aria-labelledby="hive-title">
    <div class="chapter-copy" data-reveal>
      <p class="chapter-num">01 — Hive Mind</p>
      <h2 id="hive-title">Memory your agents share.</h2>
      <p>
        Save a lasting preference, project decision, or named concept once. Hive Mind recalls it in
        later chats and projects on the same server, records which chat supplied it, and lets you
        correct or forget it.
      </p>
      <ul class="verbs">
        <li><b>Remember</b> facts in plain language</li>
        <li><b>Recall</b> what it knows about a subject</li>
        <li><b>Correct</b> a fact under the same subject</li>
        <li><b>Forget</b> anything you no longer want kept</li>
      </ul>
    </div>
    <figure class="art art-hive" data-reveal style="--d: 120ms">
      <svg viewBox="0 0 440 250" aria-hidden="true">
        {hexes.map((h) => (
          <g class:list={["hex", { "hex-label": h.label }]} style={`--d: ${h.d}ms`}>
            <polygon points={h.points} />
            {h.label && <text x={h.cx} y={h.cy + 4} text-anchor="middle">{h.label}</text>}
          </g>
        ))}
      </svg>
    </figure>
  </section>

  <section class="chapter chapter-flip container" aria-labelledby="delegate-title">
    <div class="chapter-copy" data-reveal>
      <p class="chapter-num">02 — Delegation</p>
      <h2 id="delegate-title">Hand off a task. Keep the leash short.</h2>
      <p>
        Give bounded tasks to worker agents on any configured provider. Each worker gets its own
        saved chat you can open, follow, and cancel. Its answer comes back for review instead of
        landing as unchecked work.
      </p>
    </div>
    <figure class="art art-delegate" data-reveal style="--d: 120ms">
      <svg viewBox="0 0 520 340" aria-hidden="true">
        <rect class="scope" x="286" y="8" width="226" height="324" rx="10" />
        <text class="scope-label" x="300" y="326">bounded scope</text>
        <rect class="box box-lead" x="8" y="138" width="200" height="64" rx="8" />
        <text class="box-title" x="24" y="166">lead chat</text>
        <text class="box-sub" x="24" y="186">3 tasks delegated</text>
        {workers.map(([name, y], i) => (
          <g class="worker" style={`--i: ${i}`}>
            <path class="wire" d={`M208 170 C250 170 250 ${y + 36} 300 ${y + 36}`} pathLength="1" />
            <rect class="box" x="300" y={y} width="196" height="72" rx="8" />
            <text class="box-title" x="314" y={y + 24}>{name}</text>
            <rect class="bar-bg" x="314" y={y + 38} width="168" height="4" rx="2" />
            <rect class="bar" x="314" y={y + 38} width="168" height="4" rx="2" />
            <text class="state state-run" x="314" y={y + 60}>running</text>
            <text class="state state-done" x="314" y={y + 60}>result ready ↩</text>
          </g>
        ))}
      </svg>
    </figure>
  </section>

  <section class="chapter container" aria-labelledby="remote-title">
    <div class="chapter-copy" data-reveal>
      <p class="chapter-num">03 — Local and remote</p>
      <h2 id="remote-title">Projects stay home. You don't have to.</h2>
      <p>
        Your projects, chats, and provider credentials stay on the machine that hosts the server.
        Reach it from other devices over your local network, Tailscale, or J1 Connect.
      </p>
    </div>
    <figure class="art art-routes" data-reveal style="--d: 120ms">
      <svg viewBox="0 0 520 240" aria-hidden="true">
        <rect class="box box-lead" x="8" y="70" width="140" height="100" rx="8" />
        <text class="box-title" x="24" y="110">your machine</text>
        <text class="box-sub" x="24" y="132">projects · chats</text>
        <text class="box-sub" x="24" y="150">credentials</text>
        <rect class="box" x="372" y="70" width="140" height="100" rx="8" />
        <text class="box-title" x="388" y="110">your devices</text>
        <text class="box-sub" x="388" y="132">web · desktop</text>
        <text class="box-sub" x="388" y="150">mobile</text>
        {routes.map((label, i) => {
          const y = 40 + i * 80;
          const d = `M148 120 C220 120 200 ${y} 260 ${y} C320 ${y} 300 120 372 120`;
          return (
            <g class="route" style={`--i: ${i}`}>
              <path class="wire" d={d} pathLength="1" />
              <path class="packet" d={d} pathLength="1" />
              <text class="route-label" x="260" y={y - 10} text-anchor="middle">{label}</text>
            </g>
          );
        })}
      </svg>
    </figure>
  </section>

  <section class="ledger container" aria-labelledby="ledger-title">
    <div class="ledger-head" data-reveal>
      <p class="chapter-num">04 — Availability</p>
      <h2 id="ledger-title">What ships, and what you build.</h2>
      <p>No store listings and no hosted accounts. Use the published Windows build, or build the other clients with your own configuration and signing.</p>
    </div>
    <ul class="ledger-rows" data-reveal style="--d: 100ms">
      {availability.map(([surface, status, kind, href]) => (
        <li>
          <span class="ledger-surface">{surface}</span>
          <span class:list={["ledger-status", kind]}><i aria-hidden="true"></i>{status}</span>
          <a href={href} class="ledger-link" aria-label={`${surface}: ${status}`}>&rarr;</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="setup container" data-reveal>
    <div class="setup-plate">
      <div>
        <p class="eyebrow">Plug in your own information</p>
        <h2>Start with your providers and a project folder.</h2>
        <p>Optional cloud, relay, signing, and telemetry settings use your own configuration.</p>
      </div>
      <div class="setup-links">
        <a class="btn btn-primary" href="/download">Download <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a class="text-link" href={BUILD_GUIDE_URL}>Build and setup guide</a>
        <a class="text-link" href={MOBILE_BUILD_GUIDE_URL}>Mobile builds</a>
        <a class="text-link" href={RELEASES_URL}>Release history</a>
      </div>
    </div>
    <p class="attribution">
      J1 Code is an independently maintained derivative of
      <a class="text-link" href="https://github.com/pingdotgg/t3code">T3 Code</a>, whose MIT license is preserved. New protected J1 material has separate <a href="/terms-of-service">license terms</a>.
    </p>
  </section>
</Layout>

<script>
  // Replays the one-shot hero signal sequence on request.
  const board = document.querySelector<SVGElement>(".board");
  document.querySelector("[data-replay]")?.addEventListener("click", () => {
    if (!board) return;
    board.classList.remove("is-live", "is-replay");
    void board.getBoundingClientRect();
    board.classList.add("is-replay");
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: clamp(56px, 9vw, 112px) 0 40px;
  }

  .hero h1 {
    margin-top: 22px;
    font-size: clamp(44px, 8.2vw, 112px);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .hero h1 span {
    color: var(--accent);
  }

  .hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
    margin-top: 36px;
  }

  .intro {
    max-width: 620px;
    color: var(--fg-muted);
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .switchboard {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .board {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }

  .switchboard figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 14px;
  }

  .replay {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .replay:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .node {
    fill: var(--bg-card);
    stroke: var(--border-strong);
  }

  .node-label,
  .surface-label,
  .hub-label {
    fill: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .surface-label {
    fill: var(--fg);
  }

  .hub-label {
    fill: var(--fg-dim);
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .pin {
    fill: var(--fg-faint);
  }

  .trace,
  .pulse {
    fill: none;
    stroke-linecap: round;
  }

  .trace {
    stroke: var(--fg-faint);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke 0.2s ease;
  }

  .pulse {
    stroke: var(--wire);
    stroke-width: 3;
    stroke-dasharray: 0.08 1.2;
    stroke-dashoffset: 0.08;
  }

  .lane:hover .trace {
    stroke: var(--accent);
  }

  .lane:hover .node {
    stroke: var(--accent);
  }

  .hub-body {
    fill: var(--fg);
  }

  .hub-glyph {
    fill: none;
    stroke: var(--bg);
    stroke-width: 14;
    stroke-linecap: square;
  }

  .hub-ring {
    fill: none;
    stroke: var(--border-strong);
  }

  .hub-ring-2 {
    stroke: var(--border);
    stroke-dasharray: 4 6;
  }

  /* One-shot signal: traces draw, pulses converge, hub flashes, pulses fan out. */
  .board.is-live .trace {
    animation: draw 1.1s var(--ease-out) both;
    animation-delay: calc(300ms + var(--i) * 90ms);
  }

  .board.is-live .lane-out .trace {
    animation-delay: calc(900ms + var(--i) * 90ms);
  }

  :is(.is-live, .is-replay) .pulse {
    animation: pulse 0.9s cubic-bezier(0.5, 0, 0.6, 1) both;
    animation-delay: calc(var(--start, 1500ms) + var(--i) * 70ms);
  }

  :is(.is-live, .is-replay) .lane-out .pulse {
    --start: 2500ms;
  }

  .is-replay .pulse {
    --start: 0ms;
  }

  .is-replay .lane-out .pulse {
    --start: 1000ms;
  }

  :is(.is-live, .is-replay) .hub-ring {
    animation: hub-flash 0.8s ease-out both;
    animation-delay: var(--flash, 2350ms);
  }

  .is-replay .hub-ring {
    --flash: 850ms;
  }

  .board.is-live .hub {
    animation: rise 0.8s var(--ease-out) both;
    animation-delay: 200ms;
  }

  @keyframes draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes pulse {
    from { stroke-dashoffset: 0.08; }
    to { stroke-dashoffset: -1; }
  }

  @keyframes hub-flash {
    0% { stroke: var(--border-strong); }
    30% { stroke: var(--accent); }
    100% { stroke: var(--border-strong); }
  }

  /* ---------- Chapters ---------- */
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-top: clamp(72px, 10vw, 140px);
  }

  .chapter-flip .chapter-copy {
    order: 2;
  }

  .chapter-num {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .chapter h2,
  .ledger h2,
  .setup h2 {
    margin: 16px 0 20px;
    font-size: clamp(30px, 3.6vw, 48px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .chapter-copy > p:not(.chapter-num),
  .ledger-head > p:not(.chapter-num),
  .setup p {
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .chapter-copy .text-link {
    display: inline-block;
    margin-top: 20px;
    font-size: 15px;
  }

  .verbs {
    display: grid;
    gap: 10px;
    margin-top: 28px;
    list-style: none;
  }

  .verbs li {
    padding-left: 18px;
    border-left: 1px solid var(--border-strong);
    color: var(--fg-dim);
    font-size: 15px;
  }

  .verbs b {
    color: var(--fg);
    font-weight: 600;
  }

  .art {
    padding: clamp(20px, 3vw, 36px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 1px 1px, rgba(243, 240, 230, 0.07) 1px, transparent 0) 0 0 / 16px 16px,
      var(--bg-elev);
  }

  .art svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Hive Mind: cells light outward from the top-left once revealed. */
  .hex polygon {
    fill: var(--bg-card);
    stroke: var(--border);
    transition: fill 0.6s ease, stroke 0.6s ease;
    transition-delay: var(--d);
  }

  .hex text {
    fill: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
    transition: fill 0.6s ease;
    transition-delay: var(--d);
  }

  .is-in .hex polygon {
    stroke: var(--border-strong);
  }

  .is-in .hex-label polygon {
    fill: var(--accent-dim);
    stroke: var(--accent);
  }

  .is-in .hex-label text {
    fill: var(--fg);
  }

  .hex-label:hover polygon {
    fill: color-mix(in oklch, var(--accent) 30%, transparent);
    transition-delay: 0ms;
  }

  /* Delegation: wires draw, bars fill, status flips to a returned result. */
  .scope {
    fill: none;
    stroke: var(--fg-faint);
    stroke-dasharray: 5 6;
  }

  .scope-label,
  .box-sub,
  .state {
    fill: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .box {
    fill: var(--bg-card);
    stroke: var(--border-strong);
  }

  .box-lead {
    stroke: var(--accent);
  }

  .box-title {
    fill: var(--fg);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .wire {
    fill: none;
    stroke: var(--fg-faint);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease-out);
    transition-delay: calc(200ms + var(--i) * 140ms);
  }

  .bar-bg {
    fill: var(--border);
  }

  .bar {
    fill: var(--wire);
    transform: scaleX(0);
    transform-box: fill-box;
    transform-origin: left;
    transition: transform 1.4s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: calc(900ms + var(--i) * 260ms);
  }

  .state {
    transition: opacity 0.3s ease;
  }

  .state-done {
    opacity: 0;
    fill: var(--ok);
    transition-delay: calc(2300ms + var(--i) * 260ms);
  }

  .state-run {
    transition-delay: calc(2300ms + var(--i) * 260ms);
  }

  .is-in .wire {
    stroke-dashoffset: 0;
  }

  .is-in .bar {
    transform: scaleX(1);
  }

  .is-in .state-run {
    opacity: 0;
  }

  .is-in .state-done {
    opacity: 1;
  }

  /* Routes: three lanes draw, then one packet crosses each. */
  .route-label {
    fill: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .packet {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 0.06 1.2;
    stroke-dashoffset: 0.06;
  }

  .is-in .packet {
    animation: pulse 1.2s cubic-bezier(0.5, 0, 0.5, 1) both;
    animation-delay: calc(1200ms + var(--i) * 200ms);
  }

  /* ---------- Availability ledger ---------- */
  .ledger {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 96px);
    padding-top: clamp(88px, 12vw, 160px);
  }

  .ledger-rows {
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .ledger-rows li {
