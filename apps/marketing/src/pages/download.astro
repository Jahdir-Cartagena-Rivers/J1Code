---
import Layout from "../layouts/Layout.astro";
import { BUILD_GUIDE_URL, MOBILE_BUILD_GUIDE_URL, RELEASES_URL } from "../lib/site";
---

<Layout title="Download — J1 Code" description="Get a published J1 Code build or build the clients from source.">
  <section class="container downloads">
    <p class="eyebrow">J1 Code downloads</p>
    <h1>Choose your build</h1>
    <p id="release-version">Published builds and checksums are on GitHub.</p>
    <div class="download-grid">
      <article>
        <h2>Windows x64</h2>
        <p>The setup installer supports in-app updates. Portable builds, when available, use manual updates. Current installers are unsigned.</p>
        <a class="btn btn-primary" data-asset="windows" href={RELEASES_URL}>View Windows releases</a>
      </article>
      <article>
        <h2>Linux runtime</h2>
        <p>The matching server runtime can run on Linux and is embedded in Windows builds for WSL. The archive retains its compatible <code>t3</code> CLI name.</p>
        <a class="btn btn-secondary" data-asset="linux" href={RELEASES_URL}>View runtime releases</a>
      </article>
      <article>
        <h2>macOS, web, and mobile</h2>
        <p>Build these clients with your own configuration and signing identity. J1 does not publish the upstream App Store or Google Play apps.</p>
        <a href={BUILD_GUIDE_URL}>Source build guide</a><br />
        <a href={MOBILE_BUILD_GUIDE_URL}>Mobile build guide</a>
      </article>
    </div>
    <p>Verify downloaded files against the release's SHA-256 checksum manifest.</p>
    <p>Cloud linking is optional. Supply your own provider accounts and any services you enable.</p>
    <a id="release-history" href={RELEASES_URL}>All J1 Code releases and release notes</a>
  </section>
</Layout>

<script>
  import { fetchLatestRelease } from "../lib/releases";

  try {
    const release = await fetchLatestRelease();
    const label = document.getElementById("release-version");
    if (label) label.textContent = `Latest release: ${release.tag_name.replace(/^j1-code-/, "")}`;
    const history = document.getElementById("release-history") as HTMLAnchorElement | null;
    if (history) history.href = release.html_url;
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-asset]")) {
      const asset = release.assets.find((item) => link.dataset.asset === "windows"
        ? /-windows-x64-setup\.exe$/.test(item.name)
        : /-linux-x64\.tar\.gz$/.test(item.name));
      if (asset) { link.href = asset.browser_download_url; link.textContent = link.dataset.asset === "windows" ? "Download Windows installer" : "Download Linux runtime"; }
    }
  } catch {
    // Private repositories and API rate limits retain the usable GitHub links.
  }
</script>

<style>
  .downloads { padding: 72px 0 100px; }
  h1 { font-size: clamp(36px, 6vw, 58px); margin: 16px 0 24px; }
  h2 { font-size: 22px; margin-bottom: 18px; }
  p { color: var(--fg-muted); line-height: 1.7; margin-bottom: 22px; }
  .download-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin: 36px 0; }
  article { padding: 28px; border: 1px solid var(--border); border-radius: 16px; background: var(--bg-card); }
</style>
