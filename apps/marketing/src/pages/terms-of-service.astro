---
import LegalPage from "../components/LegalPage.astro";
import { J1_SOURCE_URL } from "@t3tools/shared/j1Brand";
const sections = [["license", "Software license"], ["providers", "Your providers"], ["attribution", "Attribution"]] as const;
---
<LegalPage title="License and services — J1 Code" description="J1 software terms, preserved MIT permissions, and your configured services." heading="J1 Code license and services" lede="J1 Code is independently maintained, source-available software with mixed licensing." lastUpdated="2026-10-05" sections={sections}>
  <section id="license"><h2>Software license</h2><p>The <a href={`${J1_SOURCE_URL}/LICENSE`}>current J1 terms</a> allow inspection of public source and use of unmodified official builds for your own work. Reuse, modification, or redistribution of new protected J1 material requires separate permission. Your own output created with J1 is not restricted by these terms.</p><p>T3 Code, dependencies, and previously MIT-distributed J1 material retain their original licenses and permissions. The new terms do not revoke earlier MIT grants. Keep required notices when using or redistributing those components. Read the <a href={`${J1_SOURCE_URL}/LICENSING.md`}>licensing boundaries</a> for the baseline and exceptions.</p></section>
  <section id="providers"><h2>Your providers</h2><p>You supply your own provider accounts, environments, and optional services. Their terms, access rules, and charges apply separately. This project does not grant access to a provider subscription or promise a hosted service.</p></section>
  <section id="attribution"><h2>Attribution</h2><p>J1 Code is based on <a href="https://github.com/pingdotgg/t3code">T3 Code</a> by T3 Tools. The original MIT copyright and third-party notices are preserved. J1 is maintained independently.</p></section>
</LegalPage>
