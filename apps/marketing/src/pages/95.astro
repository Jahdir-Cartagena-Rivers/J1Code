---
import { Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
---
<Layout title="J1 Code — Retro edition">
  <section class="container retro">
    <div class="title-bar">J1 Code.exe</div>
    <div class="content">
      <Image src={appIcon} width={112} height={112} alt="J1 Code logo" />
      <h1>J1 Code</h1>
      <p>Your coding agents, shared memory, and projects in one workspace.</p>
      <a class="btn btn-primary" href="/download">Get J1 Code</a>
      <a href={GITHUB_REPOSITORY_URL}>Open the source</a>
      <p>Bring your own providers and configuration. Distributed under the MIT license.</p>
    </div>
  </section>
</Layout>
<style>
  .retro { max-width: 720px; margin: 72px auto; padding: 4px; background: #c0c0c0; border: 3px outset white; color: black; font-family: monospace; }
  .title-bar { padding: 8px 12px; background: navy; color: white; font-weight: bold; }
  .content { padding: 36px; text-align: center; }
  img { margin: 0 auto 24px; }
  h1 { font-size: 44px; }
  p { margin: 24px 0; line-height: 1.7; }
  a { display: inline-block; margin: 12px; }
</style>
