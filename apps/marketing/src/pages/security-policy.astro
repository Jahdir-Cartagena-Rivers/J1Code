---
import LegalPage from "../components/LegalPage.astro";
import { J1_SOURCE_URL } from "@t3tools/shared/j1Brand";
const sections = [["reports", "Report a vulnerability"], ["environments", "Protect your environments"]] as const;
---
<LegalPage title="Security — J1 Code" description="Vulnerability reports and environment security for J1 Code." heading="J1 Code security" lede="Report J1 issues to this project and protect the environments you authorize." lastUpdated="2026-10-03" sections={sections}>
  <section id="reports"><h2>Report a vulnerability</h2><p>Follow the <a href={`${J1_SOURCE_URL}/.github/SECURITY.md`}>J1 Code security policy</a>. Keep credentials, private pairing links, and exploit details out of public issues. Report a third-party service vulnerability to that service's operator.</p></section>
  <section id="environments"><h2>Protect your environments</h2><p>Authorize only clients and agents you trust. Keep software up to date, restrict network access, and protect local profiles and backups. Configure optional cloud services and diagnostic credentials for your own deployment.</p></section>
</LegalPage>
