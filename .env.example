# Copy to .env only when configuring optional services. Local providers and
# local/LAN connections work without cloud credentials. Leave unused values blank.
# T3CODE_* names are retained for compatibility with the shared server protocol.

# Optional cloud sign-in and your own relay deployment.
T3CODE_CLERK_PUBLISHABLE_KEY=
T3CODE_CLERK_JWT_TEMPLATE=
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
T3CODE_RELAY_URL=
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Optional desktop update feed: your GitHub owner/repository, without a URL.
# For a public repository leave PRIVATE=false. For a private feed set true;
# end users authenticate using gh auth login or a runtime GH_TOKEN/GITHUB_TOKEN.
T3CODE_DESKTOP_UPDATE_REPOSITORY=
T3CODE_DESKTOP_UPDATE_PRIVATE=false

# Optional signed Windows builds. Requires your own verified Microsoft Artifact
# Signing identity. For automated releases use Actions secrets, not this file.
# T3CODE_DESKTOP_SIGNED=true
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TRUSTED_SIGNING_ENDPOINT=
# AZURE_TRUSTED_SIGNING_ACCOUNT_NAME=
# AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE_NAME=
# AZURE_TRUSTED_SIGNING_PUBLISHER_NAME=

# Optional signed macOS builds. Supply your own Apple Developer configuration.
# T3CODE_APPLE_TEAM_ID=
# T3CODE_MACOS_PROVISIONING_PROFILE=
# Native mobile associated domains and signed macOS passkeys use your own hostnames.
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Optional separately branded mobile build. Supply your own Expo/signing identity.
# J1CODE_MARKETING_SITE_URL=https://j1.example.com
# EXPO_PUBLIC_MARKETING_SITE_URL=https://j1.example.com
# J1CODE_APPLE_TEAM_ID=
# J1CODE_EAS_PROJECT_ID=
# J1CODE_EXPO_OWNER=

# Optional telemetry. Client configuration is embedded in shipped bundles;
# use only restricted, ingest-only credentials. Never put server secrets here.
# T3CODE_MOBILE_OTLP_TRACES_URL=
# T3CODE_MOBILE_OTLP_TRACES_DATASET=
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=
# T3CODE_RELAY_CLIENT_OTLP_TRACES_URL=
# T3CODE_RELAY_CLIENT_OTLP_TRACES_DATASET=
# T3CODE_RELAY_CLIENT_OTLP_TRACES_TOKEN=
