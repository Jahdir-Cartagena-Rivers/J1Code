# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
# Preserve whitespace in upstream license notices.
third_party/mausbot/cua-driver-windows/*.txt -whitespace
# Unified diffs preserve the space prefix on empty context lines.
scripts/mausbot/upstream/*.patch whitespace=-blank-at-eol
